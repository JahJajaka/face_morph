FROM python:3.9-slim

# System deps for OpenCV + ffmpeg for video assembly
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY *.py ./
COPY effects.json ./

RUN mkdir -p /app/morph_results

CMD ["python", "main.py"]